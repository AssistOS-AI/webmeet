{
  "container": "python:3.12-slim",
  "entrypoint": "/bin/sh",
  "start": "/code/scripts/startAgent.sh",
  "about": "WebMeet self-hosted Faster-Whisper speech-to-text service.",
  "health": {
    "readiness": {
      "script": "healthcheck.sh",
      "interval": 2,
      "timeout": 5,
      "failureThreshold": 180,
      "successThreshold": 1
    }
  },
  "network": {
    "mode": "bridge",
    "attachments": [
      {
        "name": "webmeet",
        "primary": true
      }
    ]
  },
  "volumes": {
    ".ploinky/data/webmeetStt": "/data"
  },
  "profiles": {
    "default": {
      "env": [
        {
          "name": "WEBMEET_STT_PORT",
          "required": false,
          "default": "9000"
        },
        {
          "name": "WHISPER_MODEL",
          "required": false,
          "default": "base"
        },
        {
          "name": "WHISPER_LANGUAGE",
          "required": false,
          "default": "auto"
        },
        {
          "name": "WHISPER_DEVICE",
          "required": false,
          "default": "cpu"
        },
        {
          "name": "WHISPER_COMPUTE_TYPE",
          "required": false,
          "default": "int8"
        },
        {
          "name": "WEBMEET_STT_DENOISE",
          "required": false,
          "default": "dtln"
        }
      ]
    },
    "dev": {
      "env": [
        {
          "name": "WEBMEET_STT_PORT",
          "required": false,
          "default": "9000"
        },
        {
          "name": "WHISPER_MODEL",
          "required": false,
          "default": "base"
        },
        {
          "name": "WHISPER_LANGUAGE",
          "required": false,
          "default": "auto"
        },
        {
          "name": "WHISPER_DEVICE",
          "required": false,
          "default": "cpu"
        },
        {
          "name": "WHISPER_COMPUTE_TYPE",
          "required": false,
          "default": "int8"
        },
        {
          "name": "WEBMEET_STT_DENOISE",
          "required": false,
          "default": "dtln"
        }
      ]
    },
    "prod": {
      "env": [
        {
          "name": "WEBMEET_STT_PORT",
          "required": false,
          "default": "9000"
        },
        {
          "name": "WHISPER_MODEL",
          "required": false,
          "default": "base"
        },
        {
          "name": "WHISPER_LANGUAGE",
          "required": false,
          "default": "auto"
        },
        {
          "name": "WHISPER_DEVICE",
          "required": false,
          "default": "cpu"
        },
        {
          "name": "WHISPER_COMPUTE_TYPE",
          "required": false,
          "default": "int8"
        },
        {
          "name": "WEBMEET_STT_DENOISE",
          "required": false,
          "default": "dtln"
        }
      ]
    }
  }
}
