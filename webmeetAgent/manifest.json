{
    "agent": "sh /code/scripts/startAgent.sh",
    "container": "node:20-alpine",
    "about": "WebMeet Agent for sovereign collaboration rooms, AI participants, and meeting artifacts.",
    "network": {
        "name": "webmeet",
        "aliases": [
            "webmeetAgent"
        ]
    },
    "enable": [
        "webmeetInfra/stack"
    ],
    "repos": {
        "webmeetInfra": "https://github.com/PloinkyRepos/webmeetInfra.git"
    },
    "volumes": {
        "webmeetAgent/data": "/data",
        "webmeet/recordings": "/recordings"
    },
    "httpServices": [
        {
            "externalPrefix": "/public-services/webmeet/",
            "internalPrefix": "/api/",
            "auth": "guest",
            "guestScope": "webmeet-public-service",
            "forceGuest": true,
            "notFoundMessage": "WebMeet route not found."
        }
    ],
    "profiles": {
        "default": {
            "env": [
                "ASSISTOS_FS_ROOT",
                "WORKSPACE_ROOT",
                "PLOINKY_WORKSPACE_ROOT",
                {
                    "name": "PLOINKY_WEBMEET_MASTER_KEY",
                    "required": false,
                    "default": "dev-webmeet-master-key"
                },
                "SOUL_GATEWAY_API_KEY",
                "LLMAgentClient_DEBUG",
                "LLMAgentClient_VERBOSE_DELAY",
                {
                    "name": "WEBMEET_DATA_DIR",
                    "required": false,
                    "default": "/data"
                },
                {
                    "name": "WEBMEET_PUBLIC_LIVEKIT_URL",
                    "required": false,
                    "default": "ws://127.0.0.1:7880"
                },
                {
                    "name": "WEBMEET_LIVEKIT_URL",
                    "required": false,
                    "default": "http://webmeetLivekitServer:7880"
                },
                {
                    "name": "WEBMEET_LIVEKIT_API_KEY",
                    "required": false,
                    "default": "devkey"
                },
                {
                    "name": "WEBMEET_LIVEKIT_API_SECRET",
                    "required": false,
                    "default": "devsecretdevsecretdevsecretdevsecret"
                },
                {
                    "name": "WEBMEET_EGRESS_URL",
                    "required": false,
                    "default": "http://webmeetLivekitEgress:7980"
                },
                {
                    "name": "WEBMEET_TURN_EXTERNAL_IP",
                    "required": false,
                    "default": "127.0.0.1"
                },
                {
                    "name": "WEBMEET_TURN_PORT",
                    "required": false,
                    "default": "3478"
                },
                {
                    "name": "WEBMEET_TURN_URLS",
                    "required": false
                },
                {
                    "name": "WEBMEET_TURN_REALM",
                    "required": false,
                    "default": "webmeet.local"
                },
                {
                    "name": "WEBMEET_TURN_USER",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_TURN_PASSWORD",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_ICE_TRANSPORT_POLICY",
                    "required": false,
                    "default": "all"
                },
                {
                    "name": "WEBMEET_ROOM_PREFIX",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_AGENT_NAME",
                    "required": false,
                    "default": "WebMeetAgent"
                },
                {
                    "name": "WEBMEET_RECORDINGS_DIR",
                    "required": false,
                    "default": "/recordings"
                },
                {
                    "name": "WEBMEET_API_PORT",
                    "required": false,
                    "default": "8791"
                },
                {
                    "name": "WEBMEET_WORKER_POLL_MS",
                    "required": false,
                    "default": "400"
                }
            ]
        },
        "dev": {
            "env": [
                "ASSISTOS_FS_ROOT",
                "WORKSPACE_ROOT",
                "PLOINKY_WORKSPACE_ROOT",
                {
                    "name": "PLOINKY_WEBMEET_MASTER_KEY",
                    "required": false,
                    "default": "dev-webmeet-master-key"
                },
                "SOUL_GATEWAY_API_KEY",
                "LLMAgentClient_DEBUG",
                "LLMAgentClient_VERBOSE_DELAY",
                {
                    "name": "WEBMEET_DATA_DIR",
                    "required": false,
                    "default": "/data"
                },
                {
                    "name": "WEBMEET_PUBLIC_LIVEKIT_URL",
                    "required": false,
                    "default": "ws://127.0.0.1:17880"
                },
                {
                    "name": "WEBMEET_LIVEKIT_URL",
                    "required": false,
                    "default": "http://webmeetLivekitServer:7880"
                },
                {
                    "name": "WEBMEET_LIVEKIT_API_KEY",
                    "required": false,
                    "default": "devkey"
                },
                {
                    "name": "WEBMEET_LIVEKIT_API_SECRET",
                    "required": false,
                    "default": "devsecretdevsecretdevsecretdevsecret"
                },
                {
                    "name": "WEBMEET_EGRESS_URL",
                    "required": false,
                    "default": "http://webmeetLivekitEgress:7980"
                },
                {
                    "name": "WEBMEET_TURN_EXTERNAL_IP",
                    "required": false,
                    "default": "127.0.0.1"
                },
                {
                    "name": "WEBMEET_TURN_PORT",
                    "required": false,
                    "default": "13478"
                },
                {
                    "name": "WEBMEET_TURN_URLS",
                    "required": false
                },
                {
                    "name": "WEBMEET_TURN_REALM",
                    "required": false,
                    "default": "webmeet.local"
                },
                {
                    "name": "WEBMEET_TURN_USER",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_TURN_PASSWORD",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_ICE_TRANSPORT_POLICY",
                    "required": false,
                    "default": "all"
                },
                {
                    "name": "WEBMEET_ROOM_PREFIX",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_AGENT_NAME",
                    "required": false,
                    "default": "WebMeetAgent"
                },
                {
                    "name": "WEBMEET_RECORDINGS_DIR",
                    "required": false,
                    "default": "/recordings"
                },
                {
                    "name": "WEBMEET_API_PORT",
                    "required": false,
                    "default": "8791"
                },
                {
                    "name": "WEBMEET_WORKER_POLL_MS",
                    "required": false,
                    "default": "400"
                }
            ]
        },
        "prod": {
            "env": [
                "ASSISTOS_FS_ROOT",
                "WORKSPACE_ROOT",
                "PLOINKY_WORKSPACE_ROOT",
                {
                    "name": "PLOINKY_WEBMEET_MASTER_KEY",
                    "required": true
                },
                "SOUL_GATEWAY_API_KEY",
                "LLMAgentClient_DEBUG",
                "LLMAgentClient_VERBOSE_DELAY",
                {
                    "name": "WEBMEET_DATA_DIR",
                    "required": false,
                    "default": "/data"
                },
                {
                    "name": "WEBMEET_PUBLIC_LIVEKIT_URL",
                    "required": true
                },
                {
                    "name": "WEBMEET_LIVEKIT_URL",
                    "required": true
                },
                {
                    "name": "WEBMEET_LIVEKIT_API_KEY",
                    "required": true
                },
                {
                    "name": "WEBMEET_LIVEKIT_API_SECRET",
                    "required": true
                },
                {
                    "name": "WEBMEET_EGRESS_URL",
                    "required": true
                },
                {
                    "name": "WEBMEET_TURN_EXTERNAL_IP",
                    "required": true
                },
                {
                    "name": "WEBMEET_TURN_PORT",
                    "required": false,
                    "default": "3478"
                },
                {
                    "name": "WEBMEET_TURN_URLS",
                    "required": false
                },
                {
                    "name": "WEBMEET_TURN_REALM",
                    "required": false,
                    "default": "webmeet.local"
                },
                {
                    "name": "WEBMEET_TURN_USER",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_TURN_PASSWORD",
                    "required": true
                },
                {
                    "name": "WEBMEET_ICE_TRANSPORT_POLICY",
                    "required": false,
                    "default": "all"
                },
                {
                    "name": "WEBMEET_ROOM_PREFIX",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_AGENT_NAME",
                    "required": false,
                    "default": "WebMeetAgent"
                },
                {
                    "name": "WEBMEET_RECORDINGS_DIR",
                    "required": false,
                    "default": "/recordings"
                },
                {
                    "name": "WEBMEET_API_PORT",
                    "required": false,
                    "default": "8791"
                },
                {
                    "name": "WEBMEET_WORKER_POLL_MS",
                    "required": false,
                    "default": "400"
                }
            ]
        }
    }
}
