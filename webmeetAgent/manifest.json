                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_TURN_PASSWORD",
                    "required": true,
                    "derive": "derived-master",
                    "deriveRepoName": "webmeet",
                    "deriveAgentName": "shared-turn",
                    "deriveName": "password"
                },
                {
                    "name": "WEBMEET_ICE_TRANSPORT_POLICY",
                    "required": false,
                    "default": "all"
                },
                {
                    "name": "WEBMEET_ROOM_PREFIX",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_AGENT_NAME",
                    "required": false,
                    "default": "WebMeetAgent"
                },
                {
                    "name": "WEBMEET_LIVEKIT_AGENT_ENABLED",
                    "required": false,
                    "default": "false"
                },
                {
                    "name": "WEBMEET_LIVEKIT_AGENT_NAME",
                    "required": false,
                    "default": "webmeet-agent"
                },
                {
                    "name": "WEBMEET_RECORDINGS_DIR",
                    "required": false,
                    "default": "/data/recordings"
                },
                {
                    "name": "WEBMEET_API_PORT",
                    "required": false,
                    "default": "8791"
                },
                {
                    "name": "WEBMEET_AGENT_INTERNAL_TOKEN",
                    "required": false,
                    "derive": "derived-master",
                    "deriveRepoName": "webmeet",
                    "deriveAgentName": "shared-agent",
                    "deriveName": "internal-token"
                }
            ]
        }
    }
}
