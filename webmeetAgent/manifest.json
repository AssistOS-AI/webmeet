{
    "agent": "sh /code/scripts/startAgent.sh",
    "container": "node:20",
    "about": "WebMeet Agent for sovereign collaboration rooms, AI participants, and meeting artifacts.",
    "network": {
        "name": "webmeet",
        "aliases": [
            "webmeetAgent"
        ]
    },
    "enable": [
        "webmeetInfra/stack",
        "webmeetLivekitAiAgent global no-wait"
    ],
    "repos": {
        "webmeetInfra": "https://github.com/PloinkyRepos/webmeetInfra.git"
    },
    "volumes": {
        ".ploinky/data/webmeetAgent/data": "/data",
        ".ploinky/data/webmeet/recordings": "/data/recordings"
    },
    "httpServices": [
        {
            "externalPrefix": "/public-services/webmeet/",
            "internalPrefix": "/api/",
            "auth": "guest",
            "guestScope": "webmeet-public-service",
            "forceGuest": true,
            "notFoundMessage": "WebMeet route not found."
        }
    ],
    "profiles": {
        "default": {
            "env": [
                "ASSISTOS_FS_ROOT",
                "WORKSPACE_ROOT",
                "PLOINKY_WORKSPACE_ROOT",
                {
                    "name": "PLOINKY_WEBMEET_MASTER_KEY",
                    "required": false,
                    "derive": "derived-master"
                },
                "SOUL_GATEWAY_API_KEY",
                "LLMAgentClient_DEBUG",
                "LLMAgentClient_VERBOSE_DELAY",
                {
                    "name": "WEBMEET_DATA_DIR",
                    "required": false,
                    "default": "/data"
                },
                {
                    "name": "WEBMEET_PUBLIC_LIVEKIT_URL",
                    "required": false,
                    "default": "ws://127.0.0.1:7880"
                },
                {
                    "name": "WEBMEET_LIVEKIT_URL",
                    "required": false,
                    "default": "http://webmeetLivekitServer:7880"
                },
                {
                    "name": "WEBMEET_LIVEKIT_API_KEY",
                    "required": false,
                    "derive": "derived-master",
                    "deriveRepoName": "webmeet",
                    "deriveAgentName": "shared-livekit",
                    "deriveName": "api-key",
                    "deriveBytes": 16
                },
                {
                    "name": "WEBMEET_LIVEKIT_API_SECRET",
                    "required": false,
                    "derive": "derived-master",
                    "deriveRepoName": "webmeet",
                    "deriveAgentName": "shared-livekit",
                    "deriveName": "api-secret"
                },
                {
                    "name": "WEBMEET_EGRESS_URL",
                    "required": false,
                    "default": "http://webmeetLivekitEgress:7980"
                },
                {
                    "name": "WEBMEET_TURN_EXTERNAL_IP",
                    "required": false,
                    "default": "127.0.0.1"
                },
                {
                    "name": "WEBMEET_TURN_HOST",
                    "required": false,
                    "default": "127.0.0.1"
                },
                {
                    "name": "WEBMEET_TURN_PORT",
                    "required": false,
                    "default": "3478"
                },
                {
                    "name": "WEBMEET_TURN_URLS",
                    "required": false
                },
                {
                    "name": "WEBMEET_TURN_REALM",
                    "required": false,
                    "default": "webmeet.local"
                },
                {
                    "name": "WEBMEET_TURN_USER",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_TURN_PASSWORD",
                    "required": false,
                    "derive": "derived-master",
                    "deriveRepoName": "webmeet",
                    "deriveAgentName": "shared-turn",
                    "deriveName": "password"
                },
                {
                    "name": "WEBMEET_ICE_TRANSPORT_POLICY",
                    "required": false,
                    "default": "all"
                },
                {
                    "name": "WEBMEET_ROOM_PREFIX",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_AGENT_NAME",
                    "required": false,
                    "default": "WebMeetAgent"
                },
                {
                    "name": "WEBMEET_LIVEKIT_AGENT_ENABLED",
                    "required": false,
                    "default": "false"
                },
                {
                    "name": "WEBMEET_LIVEKIT_AGENT_NAME",
                    "required": false,
                    "default": "webmeet-agent"
                },
                {
                    "name": "WEBMEET_RECORDINGS_DIR",
                    "required": false,
                    "default": "/data/recordings"
                },
                {
                    "name": "WEBMEET_API_PORT",
                    "required": false,
                    "default": "8791"
                },
                {
                    "name": "WEBMEET_AGENT_INTERNAL_TOKEN",
                    "required": false,
                    "derive": "derived-master",
                    "deriveRepoName": "webmeet",
                    "deriveAgentName": "shared-agent",
                    "deriveName": "internal-token"
                }
            ]
        },
        "dev": {
            "env": [
                "ASSISTOS_FS_ROOT",
                "WORKSPACE_ROOT",
                "PLOINKY_WORKSPACE_ROOT",
                {
                    "name": "PLOINKY_WEBMEET_MASTER_KEY",
                    "required": false,
                    "derive": "derived-master"
                },
                "SOUL_GATEWAY_API_KEY",
                "LLMAgentClient_DEBUG",
                "LLMAgentClient_VERBOSE_DELAY",
                {
                    "name": "WEBMEET_DATA_DIR",
                    "required": false,
                    "default": "/data"
                },
                {
                    "name": "WEBMEET_PUBLIC_LIVEKIT_URL",
                    "required": false,
                    "default": "ws://127.0.0.1:17880"
                },
                {
                    "name": "WEBMEET_LIVEKIT_URL",
                    "required": false,
                    "default": "http://webmeetLivekitServer:17880"
                },
                {
                    "name": "WEBMEET_LIVEKIT_API_KEY",
                    "required": false,
                    "derive": "derived-master",
                    "deriveRepoName": "webmeet",
                    "deriveAgentName": "shared-livekit",
                    "deriveName": "api-key",
                    "deriveBytes": 16
                },
                {
                    "name": "WEBMEET_LIVEKIT_API_SECRET",
                    "required": false,
                    "derive": "derived-master",
                    "deriveRepoName": "webmeet",
                    "deriveAgentName": "shared-livekit",
                    "deriveName": "api-secret"
                },
                {
                    "name": "WEBMEET_EGRESS_URL",
                    "required": false,
                    "default": "http://webmeetLivekitEgress:7980"
                },
                {
                    "name": "WEBMEET_TURN_EXTERNAL_IP",
                    "required": false,
                    "default": "127.0.0.1"
                },
                {
                    "name": "WEBMEET_TURN_HOST",
                    "required": false,
                    "default": "127.0.0.1"
                },
                {
                    "name": "WEBMEET_TURN_PORT",
                    "required": false,
                    "default": "13478"
                },
                {
                    "name": "WEBMEET_TURN_URLS",
                    "required": false
                },
                {
                    "name": "WEBMEET_TURN_REALM",
                    "required": false,
                    "default": "webmeet.local"
                },
                {
                    "name": "WEBMEET_TURN_USER",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_TURN_PASSWORD",
                    "required": false,
                    "derive": "derived-master",
                    "deriveRepoName": "webmeet",
                    "deriveAgentName": "shared-turn",
                    "deriveName": "password"
                },
                {
                    "name": "WEBMEET_ICE_TRANSPORT_POLICY",
                    "required": false,
                    "default": "all"
                },
                {
                    "name": "WEBMEET_ROOM_PREFIX",
                    "required": false,
                    "default": "webmeet"
                },
                {
                    "name": "WEBMEET_AGENT_NAME",
                    "required": false,
                    "default": "WebMeetAgent"
                },
                {
                    "name": "WEBMEET_LIVEKIT_AGENT_ENABLED",
                    "required": false,
                    "default": "false"
                },
                {
                    "name": "WEBMEET_LIVEKIT_AGENT_NAME",
                    "required": false,
                    "default": "webmeet-agent"
                },
                {
                    "name": "WEBMEET_RECORDINGS_DIR",
                    "required": false,
                    "default": "/data/recordings"
                },
                {
                    "name": "WEBMEET_API_PORT",
                    "required": false,
                    "default": "8791"
                },
                {
                    "name": "WEBMEET_AGENT_INTERNAL_TOKEN",
                    "required": false,
                    "derive": "derived-master",
                    "deriveRepoName": "webmeet",
                    "deriveAgentName": "shared-agent",
                    "deriveName": "internal-token"
                }
            ]
        },
        "prod": {
            "env": [
                "ASSISTOS_FS_ROOT",
                "WORKSPACE_ROOT",
                "PLOINKY_WORKSPACE_ROOT",
                {
                    "name": "PLOINKY_WEBMEET_MASTER_KEY",
                    "required": true,
                    "derive": "derived-master"
                },
                "SOUL_GATEWAY_API_KEY",
                "LLMAgentClient_DEBUG",
                "LLMAgentClient_VERBOSE_DELAY",
                {
                    "name": "WEBMEET_DATA_DIR",
                    "required": false,
                    "default": "/data"
                },
                {
                    "name": "WEBMEET_PUBLIC_LIVEKIT_URL",
                    "required": true,
                    "default": "wss://livekit-skills.axiologic.dev"
                },
                {
                    "name": "WEBMEET_LIVEKIT_URL",
                    "required": true,
                    "default": "http://host.containers.internal:7880"
                },
                {
                    "name": "WEBMEET_LIVEKIT_API_KEY",
                    "required": true,
                    "derive": "derived-master",
                    "deriveRepoName": "webmeet",
                    "deriveAgentName": "shared-livekit",
                    "deriveName": "api-key",
                    "deriveBytes": 16
                },
                {
                    "name": "WEBMEET_LIVEKIT_API_SECRET",
                    "required": true,
                    "derive": "derived-master",
                    "deriveRepoName": "webmeet",
                    "deriveAgentName": "shared-livekit",
                    "deriveName": "api-secret"
                },
                {
                    "name": "WEBMEET_EGRESS_URL",
                    "required": true,
                    "default": "http://webmeetLivekitEgress:7980"
                },
                {
                    "name": "WEBMEET_TURN_EXTERNAL_IP",
                    "required": false
                },
                {
                    "name": "WEBMEET_TURN_HOST",
                    "required": true,
                    "default": "livekit-skills.axiologic.dev"
                },
                {
