{
  "tools": [
    {
      "name": "webmeet_workspace_list",
      "title": "WebMeet List Workspaces",
      "description": "List WebMeet workspaces.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {},
      "env": { "TOOL_NAME": "webmeet_workspace_list" }
    },
    {
      "name": "webmeet_workspace_create",
      "title": "WebMeet Create Workspace",
      "description": "Create a WebMeet workspace.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "name": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_workspace_create" }
    },
    {
      "name": "webmeet_meeting_list",
      "title": "WebMeet List Meetings",
      "description": "List meetings for a workspace.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "workspaceId": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_meeting_list" }
    },
    {
      "name": "webmeet_meeting_create",
      "title": "WebMeet Create Meeting",
      "description": "Create a meeting in a workspace.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "workspaceId": { "type": "string", "optional": false },
        "title": { "type": "string", "optional": false },
        "roomType": { "type": "string", "optional": true, "enum": ["team", "guest"] }
      },
      "env": { "TOOL_NAME": "webmeet_meeting_create" }
    },
    {
      "name": "webmeet_meeting_join",
      "title": "WebMeet Join Meeting",
      "description": "Create a participant session and LiveKit token for a meeting.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false },
        "displayName": { "type": "string", "optional": true },
        "participantId": { "type": "string", "optional": true },
        "avatar": {
          "type": "object",
          "optional": true,
          "properties": {
            "enabled": { "type": "boolean", "optional": true },
            "fallbackLetter": { "type": "string", "optional": true },
            "config": {
              "type": "object",
              "optional": true,
              "properties": {
                "agentId": { "type": "string", "optional": true },
                "generated": { "type": "boolean", "optional": true },
                "src": { "type": "string", "optional": true },
                "packSrc": { "type": "string", "optional": true },
                "assetMode": { "type": "string", "optional": true },
                "emotion": { "type": "string", "optional": true },
                "size": { "type": "string", "optional": true },
                "thought": { "type": "string", "optional": true },
                "thoughtMode": { "type": "string", "optional": true },
                "mode": { "type": "string", "optional": true },
                "shape": { "type": "string", "optional": true },
                "theme": { "type": "string", "optional": true },
                "animated": { "type": "boolean", "optional": true },
                "listen": { "type": "boolean", "optional": true },
                "seed": { "type": "string", "optional": true },
                "style": { "type": "string", "optional": true },
                "palette": { "type": "string", "optional": true },
                "complexity": { "type": "string", "optional": true }
              }
            }
          }
        }
      },
      "env": { "TOOL_NAME": "webmeet_meeting_join" }
    },
    {
      "name": "webmeet_meeting_join_guest",
      "title": "WebMeet Join Guest Meeting",
      "description": "Create a guest participant session and LiveKit token for a guest meeting.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false },
        "guestToken": { "type": "string", "optional": false },
        "displayName": { "type": "string", "optional": false },
        "participantId": { "type": "string", "optional": true }
      },
      "env": { "TOOL_NAME": "webmeet_meeting_join_guest" }
    },
    {
      "name": "webmeet_meeting_leave",
      "title": "WebMeet Leave Meeting",
      "description": "Remove a participant from active meeting members.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false },
        "participantId": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_meeting_leave" }
    },
    {
      "name": "webmeet_meeting_presence_ping",
      "title": "WebMeet Presence Ping",
      "description": "Update participant lastSeenAt for active presence.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false },
        "participantId": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_meeting_presence_ping" }
    },
    {
      "name": "webmeet_workspace_events_list",
      "title": "WebMeet List Workspace Events",
      "description": "List authenticated workspace events after an optional event id.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "workspaceId": { "type": "string", "optional": false },
        "afterId": { "type": "string", "optional": true }
      },
      "env": { "TOOL_NAME": "webmeet_workspace_events_list" }
    },
    {
      "name": "webmeet_meeting_events_list",
      "title": "WebMeet List Meeting Events",
      "description": "List authenticated meeting events after an optional event id.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false },
        "afterId": { "type": "string", "optional": true }
      },
      "env": { "TOOL_NAME": "webmeet_meeting_events_list" }
    },
    {
      "name": "webmeet_meeting_get",
      "title": "WebMeet Get Meeting",
      "description": "Get meeting details, including participants.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false },
        "includeParticipants": { "type": "boolean", "optional": true }
      },
      "env": { "TOOL_NAME": "webmeet_meeting_get" }
    },
    {
      "name": "webmeet_participant_avatar_update",
      "title": "WebMeet Update Participant Avatar",
      "description": "Publish the current user's safe participant avatar projection for a meeting.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false },
        "participantId": { "type": "string", "optional": false },
        "avatar": { "type": "object", "optional": true }
      },
      "env": { "TOOL_NAME": "webmeet_participant_avatar_update" }
    },
    {
      "name": "webmeet_meeting_rename",
      "title": "WebMeet Rename Meeting",
      "description": "Rename a meeting.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false },
        "title": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_meeting_rename" }
    },
    {
      "name": "webmeet_chat_list",
      "title": "WebMeet List Chat",
      "description": "List meeting chat messages.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_chat_list" }
    },
    {
      "name": "webmeet_chat_send",
      "title": "WebMeet Send Chat",
      "description": "Send a chat message to a meeting.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false },
        "message": { "type": "string", "optional": false },
        "authorId": { "type": "string", "optional": true },
        "authorName": { "type": "string", "optional": true }
      },
      "env": { "TOOL_NAME": "webmeet_chat_send" }
    },
    {
      "name": "webmeet_transcript_append",
      "title": "WebMeet Append Transcript",
      "description": "Append a transcript segment to a meeting.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false },
        "speakerId": { "type": "string", "optional": false },
        "speakerName": { "type": "string", "optional": false },
        "text": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_transcript_append" }
    },
    {
      "name": "webmeet_transcript_list",
      "title": "WebMeet List Transcript",
      "description": "List transcript segments for a meeting.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_transcript_list" }
    },
    {
      "name": "webmeet_agent_attach",
      "title": "WebMeet Attach Agent",
      "description": "Explicitly dispatch the self-hosted LiveKit AI agent to a meeting.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false },
        "agentType": { "type": "string", "optional": false },
        "mode": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_agent_attach" }
    },
    {
      "name": "webmeet_agent_list",
      "title": "WebMeet List Agents",
      "description": "List LiveKit AI agent dispatch metadata for a meeting.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_agent_list" }
    },
    {
      "name": "webmeet_agent_detach",
