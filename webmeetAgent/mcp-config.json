      "description": "List WebMeet rooms visible to the current authenticated user.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {},
      "env": { "TOOL_NAME": "webmeet_room_list" }
    },
    {
