      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false },
        "agentId": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_agent_detach" }
    },
    {
      "name": "webmeet_recording_start",
      "title": "WebMeet Start Recording",
      "description": "Start a real LiveKit Egress recording for a meeting.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_recording_start" }
    },
    {
      "name": "webmeet_recording_stop",
      "title": "WebMeet Stop Recording",
      "description": "Stop a real LiveKit Egress recording and persist the resulting artifact metadata.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "meetingId": { "type": "string", "optional": false }
      },
      "env": { "TOOL_NAME": "webmeet_recording_stop" }
    },
    {
      "name": "webmeet_artifact_list",
      "title": "WebMeet List Artifacts",
