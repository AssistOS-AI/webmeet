      "cwd": "workspace",
      "inputSchema": {},
      "env": { "TOOL_NAME": "webmeet_room_list" }
    },
    {
      "name": "webmeet_room_create",
      "title": "WebMeet Create Room",
      "description": "Create a WebMeet room.",
      "command": "tools/webmeet_tool.sh",
      "cwd": "workspace",
      "inputSchema": {
        "name": { "type": "string", "optional": false },
        "roomType": { "type": "string", "optional": true, "enum": ["team", "guest"] }
      },
      "env": { "TOOL_NAME": "webmeet_room_create" }
    },
